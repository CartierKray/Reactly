# Voorbeeld van de omgevingsvariabelen. Kopieer naar .env.local (lokaal) of
# zet ze in Vercel (Project → Settings → Environment Variables).
# Zet hier nooit echte sleutels in: dit bestand gaat mee in git.

# ── AI-chat ──────────────────────────────────────────────────────────────
# Claude (Anthropic) is de standaard. Zonder deze sleutel valt de chat terug
# op OPENAI_API_KEY.
ANTHROPIC_API_KEY=
# Optioneel: ander Claude-model (standaard claude-sonnet-5-5, zoals BeterLease).
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Reserve voor de chat.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.2

# ── Aanvragen per mail (Resend) ─────────────────────────────────────────
# Verifieer eerst het domein reactly.nl in Resend (Domains → Add domain,
# DNS-records bij je domeinbeheerder), anders weigert Resend info@reactly.nl.
# Gebruik een sleutel met volledige toegang: het dashboard beheert ook
# contacten, segmenten en mailings.
RESEND_API_KEY=
LEAD_TO_EMAIL=cartierkray@gmail.com
LEAD_FROM_EMAIL=Reactly <info@reactly.nl>
# Antwoordadres in de bevestigingsmail aan de klant (standaard info@reactly.nl).
# LEAD_REPLY_TO=info@reactly.nl
# Segment waarin elke website-aanvraag als contact komt (standaard Website-aanvragen).
# RESEND_LEADS_SEGMENT=Website-aanvragen

# ── Intern dashboard (/dashboard) ───────────────────────────────────────
# Zonder wachtwoord is het dashboard online dicht (lokaal open).
DASHBOARD_PASSWORD=
# Optioneel: lange willekeurige tekst om sessies te ondertekenen.
# DASHBOARD_SECRET=
# Afzender van mailings vanuit het dashboard (geverifieerd domein in Resend).
# DASHBOARD_MAIL_FROM=Reactly <info@reactly.nl>

# ── Meta Ads (dashboard) en Conversions API (website) ───────────────────
# Systeemgebruikerstoken uit Business Manager met ads_management en ads_read.
META_ACCESS_TOKEN=
# Advertentieaccount, bv. act_1234567890.
META_AD_ACCOUNT_ID=
# Facebook-pagina waarmee nieuwe advertenties worden geplaatst.
META_PAGE_ID=
# Pixel (ook voor campagnes op leads) en het token voor de Conversions API.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Optioneel: testcode uit Events Manager om server-events te controleren.
# META_TEST_EVENT_CODE=
# META_API_VERSION=v27.0

# ── Google Ads (dashboard) ──────────────────────────────────────────────
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
# Klant-ID van het advertentieaccount, zonder streepjes.
GOOGLE_ADS_CUSTOMER_ID=
# Optioneel: ID van je manageraccount.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# GOOGLE_ADS_API_VERSION=v26

# ── Reserve via EmailJS (optioneel) ─────────────────────────────────────
# NEXT_PUBLIC_EMAILJS_SERVICE_ID=
# NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
# NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
# EMAILJS_PRIVATE_KEY=

# ── Optioneel: elke aanvraag ook naar een CRM-webhook (Zapier, Make, n8n) ─
# LEAD_WEBHOOK_URL=

# ── Tracking op de website (laadt pas na toestemming) ───────────────────
# Meta Pixel.
# NEXT_PUBLIC_META_PIXEL_ID=
# Google Ads-tag en het conversielabel van de actie "Aanvraag".
# NEXT_PUBLIC_GOOGLE_ADS_ID=AW-123456789
# NEXT_PUBLIC_GOOGLE_ADS_LEAD_LABEL=
# Google Analytics 4 en/of Tag Manager.
# NEXT_PUBLIC_GA_ID=
# NEXT_PUBLIC_GTM_ID=
# Optioneel: vast adres van de site (anders automatisch het Vercel-adres).
# NEXT_PUBLIC_SITE_URL=https://www.reactly.nl
